all  mean_value_f1  \\\n0                               0  ...           0.015247       0.014517   \n1                              85  ...           0.311180       0.286577   \n\n   mean_soft_value_precision  mean_soft_value_recall  mean_soft_value_f1  \\\n0                   0.044298                0.044121            0.040952   \n1                   0.394222                0.446634            0.411652   \n\n   matched_values  reference_values  generated_values  mean_generated_tokens  \\\n0              62              3856              2951                 882.04   \n1            1150              3856              3872                 648.50   \n\n   max_5gram_repeat_ge_3_cases  \n0                           87  \n1                           46  \n\n[2 rows x 24 columns]'}, 'metadata': {}, 'output_type': 'display_data'}, {'name': 'stdout', 'output_type': 'stream', 'text': 'Preselected decoding tag: gen_rp_1.08\n'}], 'source': 'summary_rows = []\nframes = {}\n\nfor cond in DECODING_CONDITIONS:\n    tag = cond["tag"]\n    b_dir = BASELINE_DIR / tag\n    b_gens = json.loads((b_dir / "generations.json").read_text(encoding="utf-8"))\n    b_diags = json.loads((b_dir / "generation_diagnostics.json").read_text(encoding="utf-8"))\n    b_df, b_sum = score_run(cases, b_gens, b_diags)\n    frames[f"base__{tag}"] = b_df\n    summary_rows.append({"model": "base", "decoding": tag, **b_sum})\n\n    f_dir = OUTPUT_DIR / f"finetuned__{tag}"\n    f_gens = json.loads((f_dir / "generations.json").read_text(encoding="utf-8"))\n    f_diags = json.loads((f_dir / "generation_diagnostics.json").read_text(encoding="utf-8"))\n    f_df, f_sum = score_run(cases, f_gens, f_diags)\n    f_df.to_csv(f_dir / "per_case.csv", index=False)\n    (f_dir / "aggregate.json").write_text(json.dumps(f_sum, indent=2), encoding="utf-8")\n    frames[f"finetuned_v4__{tag}"] = f_df\n    summary_rows.append({"model": "finetuned_v4", "decoding": tag, **f_sum})\n\nsummary_df = pd.DataFrame(summary_rows)\nsummary_df.to_csv(OUTPUT_DIR / "summary_comparison.csv", index=False)\n(OUTPUT_DIR / "summary_comparison.json").write_text(json.dumps(summary_rows, indent=2), encoding="utf-8")\n\n# Side-by-side per-case table for the preselected decoding\nft_runs = [r for r in summary_rows if r["model"] == "finetuned_v4"]\nbest_tag = "gen_rp_1.08"  # Frozen before baseline; no decoding selection\nbase_best = frames[f"base__{best_tag}"].rename(columns=lambda c: c if c in ("case_id", "reference") else f"base_{c}")\nft_best = frames[f"finetuned_v4__{best_tag}"].drop(columns=["reference"]).rename(columns=lambda c: c if c == "case_id" else f"ft_{c}")\ncase_comp = base_best.merge(ft_best, on="case_id", validate="one_to_one")\ncase_comp.to_csv(OUTPUT_DIR / "case_comparison.csv", index=False)\ndisplay(summary_df)\nprint("Preselected decoding tag:", best_tag, flush=True)'}, {'cell_type': 'markdown', 'id': '03_eval_and_compare_11', 'metadata': {}, 'source': '## Save illustrative examples and archive\nExamples are selected by reference-agreement scores, not clinical adjudication.'}, {'cell_type': 'code', 'execution_count': 6, 'id': '03_eval_and_compare_12', 'metadata': {'execution': {'iopub.execute_input': '2026-11-23T11:23:22.963126Z', 'iopub.status.busy': '2026-11-23T11:23:22.962779Z', 'iopub.status.idle': '2026-11-23T11:23:23.031414Z', 'shell.execute_reply': '2026-11-23T11:23:23.030663Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': '# Side-by-Side Showcase (`gen_rp_1.08`)\n\n## validation:2438\n- **Base:** raw_valid=False, exact_F1=0.058, soft_F1=0.172, toks=1136\n- **Fine-tuned v3:** raw_valid=True, exact_keys=False, exact_F1=0.614, soft_F1=0.699, toks=602\n\n**Clinical Note (excerpt):**\n```\nWe present the case of a 51-year-old Caucasian woman with a four-year history of recurrent, right-sided facial pain, in the distribution of all three branches of the trigeminal nerve. These episodes occurred on average two to three times per week and were characterised