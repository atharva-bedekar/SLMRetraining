{'cells': [{'cell_type': 'markdown', 'id': '01_baseline_eval_0', 'metadata': {}, 'source': '# Base-model baseline for the reduced-schema pilot\nFP32 Gemma 270M; 100 development cases. Greedy decoding with generated-only repetition penalty 1.08, fixed before evaluation.'}, {'cell_type': 'markdown', 'id': '01_baseline_eval_1', 'metadata': {}, 'source': '## Install the established clinical dependencies'}, {'cell_type': 'code', 'execution_count': 1, 'id': '01_baseline_eval_2', 'metadata': {'execution': {'iopub.execute_input': '2026-11-23T08:54:18.016927Z', 'iopub.status.busy': '2026-11-23T08:54:18.016564Z', 'iopub.status.idle': '2026-11-23T08:54:22.691466Z', 'shell.execute_reply': '2026-11-23T08:54:22.690759Z'}, 'trusted': False}, 'outputs': [], 'source': '%pip install -q "transformers==4.57.6" "datasets==4.8.5" "peft==0.18.1" "accelerate==1.15.0" pandas huggingface_hub nbclient nbformat\n'}, {'cell_type': 'markdown', 'id': '01_baseline_eval_3', 'metadata': {}, 'source': '## Verify data and freeze the comparison contract'}, {'cell_type': 'code', 'execution_count': 2, 'id': '01_baseline_eval_4', 'metadata': {'execution': {'iopub.execute_input': '2026-11-23T08:54:22.700472Z', 'iopub.status.busy': '2026-11-23T08:54:22.700182Z', 'iopub.status.idle': '2026-11-23T08:54:39.749608Z', 'shell.execute_reply': '2026-11-23T08:54:39.748782Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': 'Baseline v3 contract saved (ca7b6e90c1019441): 100 val cases, device=cuda, dtype=torch.float32\n'}], 'source': 'import os, sys\nfrom pathlib import Path\nos.chdir("/content/clinical_v4")\nsys.path.insert(0, str(Path.cwd()))\nimport os, json, hashlib, random, re, time, shutil, importlib.metadata\nfrom pathlib import Path\nfrom getpass import getpass\nfrom collections import Counter\nimport pandas as pd\nimport torch\nfrom datasets import load_from_disk\nfrom huggingface_hub import get_token\nfrom transformers import (\n    AutoModelForCausalLM,\n    AutoTokenizer,\n    LogitsProcessor,\n    LogitsProcessorList,\n)\n\ndef digest(value):\n    return hashlib.sha256(json.dumps(value, ensure_ascii=False, sort_keys=True).encode()).hexdigest()\n\ndef file_sha(path):\n    sha = hashlib.sha256()\n    with Path(path).open("rb") as handle:\n        for block in iter(lambda: handle.read(1024 * 1024), b""):\n            sha.update(block)\n    return sha.hexdigest()\n\ndef read_token():\n    token = os.environ.get("HF_TOKEN") or get_token()\n    if not token:\n        raise RuntimeError("Missing HF_TOKEN; configure credentials before execution.")\n    if not token:\n        raise RuntimeError("A Hugging Face token with accepted Gemma access is required.")\n    os.environ["HF_TOKEN"] = token\n    return token\n\ndef runtime_path(path, sentinel):\n    path = Path(path).expanduser()\n    candidates = [path]\n    if not path.is_absolute():\n        candidates += [parent / path for parent in Path.cwd().parents]\n        candidates.append(Path("/content") / path)\n    for candidate in candidates:\n        if (candidate / sentinel).is_file():\n            return candidate.resolve()\n    raise FileNotFoundError(f"Kernel directory: {Path.cwd()}; missing {sentinel} under {path}.")\n\nclass GeneratedOnlyRepetitionPenalty(LogitsProcessor):\n    """Applies standard repetition penalty only to generated post-prompt tokens."""\n    def __init__(self, penalty: float, prompt_length: int):\n        if penalty <= 0:\n            raise ValueError("penalty must be > 0")\n        self.penalty = float(penalty)\n        self.prompt_length = int(prompt_length)\n\n    def __call__(self, input_ids: torch.LongTensor, scores: torch.FloatTensor) -> torch.FloatTensor:\n        if self.penalty == 1.0 or input_ids.shape[1] <= self.prompt_length:\n            return scores\n        gen_ids = input_ids[:, self.prompt_length :]\n        if gen_ids.shape[0] == 1:\n            gen_ids = torch.unique(gen_ids[0]).unsqueeze(0)\n        score = torch.gather(scores, 1, gen_ids)\n        score = torch.where(score < 0, score * self.penalty, score / self.penalty)\n        return scores.scatter(1, gen_ids, score)\n\nPREPARED_ROOT = runtime_path("prepared_clinical_dataset", "latest_v3_regenerated.json")\npointer = json.loads((PREPARED_ROOT / "latest_v3_regenerated.json").read_text(encoding="utf-8"))\nDATASET_VERSION = pointer["version"]\nprepared_dir = PREPARED_ROOT / DATASET_VERSION\nmanifest = json.loads((prepared_dir / "manifest.json").read_text(encoding="utf-8"))\nprepared = load_from_disk(str(prepared_dir / "dataset"))\nfor split, sha in manifest["split_sha256"].items():\n    assert digest(prepared[split].to_list()) == sha, f"Prepared {split} changed"\n\ncfg = manifest["config"]\nMODEL_ID = cfg["model"]\nMODEL_REVISION = cfg["model_revision"]\nSEED = cfg["seed"]\nMAX_NEW_TOKENS = 2048\nINFERENCE_DTYPE = "float32"\nDECODING_CONDITIONS = [\n    {"tag": "gen_rp_1.08", "repetition_penalty": 1.08, "generated_only": True},\n]\n\nOUTPUT_ROOT = (Path("/content/clinical_v4/results_v4") if Path("/content").is_dir() else Path("results_v4")) / "baseline"\nOUTPUT_ROOT.mkdir(parents=True, exist_ok=True)\n\ncases = prepared["validation"].to_list()\nassert importlib.metadata.version("transformers") == "4.57.6"\n\ndevice = "cuda" if torch.cuda.is_available() else "cpu"\ndtype = torch.float32\ncontract = {\n    "dataset_version": DATASET_VERSION,\n    "schema_version": cfg["schema_version"],\n    "model": MODEL_ID,\n    "base_model_revision": MODEL_REVISION,\n    "train_sha256": manifest["split_sha256"]["train"],\n    "validation_sha256": manifest["split_sha256"]["validation"],\n    "case_ids": [c["case_id"] for c in cases],\n    "prompt_sha256": digest([c["prompt_text"] for c in cases]),\n    "max_new_tokens": MAX_NEW_TOKENS,\n    "do_sample": False,\n    "dtype": INFERENCE_DTYPE,\n    "seed": SEED,\n    "tokenizer_add_special_tokens": False,\n    "decoding_conditions": DECODING_CONDITIONS,\n    "metrics_version": 3,\n    "transformers": importlib.metadata.version("transformers"),\n    "torch": torch.__version__,\n}\ncontract_path = OUTPUT_ROOT / "comparison_contract.json"\nif contract_path.exists():\n    assert json.loads(contract_path.read_text(encoding="utf-8")) == contract, "Refusing to reuse outputs under a changed contract"\n(OUTPUT_ROOT / "comparison_contract.json").write_text(json.dumps(contract, indent=2), encoding="utf-8")\nselection = [{"case_id": c["case_id"], "note": c["note"], "reference": c["reference"], "prompt_text": c["prompt_text"]} for c in cases]\n(OUTPUT_ROOT / "selection.json").write_text(json.dumps(selection, ensure_ascii=False, indent=2), encoding="utf-8")\nprint(f"Baseline v3 contract saved ({DATASET_VERSION}): {len(cases)} val cases, device={device}, dtype={dtype}", flush=True)'}, {'cell_type': 'markdown', 'id': '01_baseline_eval_5', 'metadata': {}, 'source': '## Parsing, schema and fact-agreement metrics\nMalformed whole objects receive zero fact credit. These metrics do not establish clinical accuracy.'}, {'cell_type': 'code', 'execution_count': 3, 'id': '01_baseline_eval_6', 'metadata': {'execution': {'iopub.execute_input': '2026-11-23T08:54:39.756721Z', 'iopub.status.busy': '2026-11-23T08:54:39.756110Z', 'iopub.status.idle': '2026-11-23T08:54:39.805581Z', 'shell.execute_reply': '2026-11-23T08:54:39.804459Z'}, 'trusted': False}, 'outputs': [{'name': 'stdout', 'output_type': 'stream', 'text': 'Metric self-checks passed.\n'}], 'source': 'from scripts.prepare_v3_dataset import schema_valid\nTOP_LEVEL_KEYS = (\n    "visit motivation", "admission", "patient information", "patient medical history",\n    "surgeries", "symptoms", "medical examinations", "diagnosis tests", "treatments", "discharge",\n)\nMISSING_VALUES = ("", "none", "null", "unknown", "not provided")\n\ndef no_duplicate_keys(pairs):\n    result = {}\n    for key, value in pairs:\n        if key in result:\n            raise ValueError("Duplicate JSON key: " + key)\n        result[key] = value\n    return result\n\ndef reject_constant(value):\n    raise ValueError("Nonstandard JSON constant: " + value)\n\ndef load_object(text, strict=True):\n    obj = json.loads(\n        text, strict=strict, object_pairs_hook=no_duplicate_keys, parse_constant=reject_constant\n    )\n    if not isinstance(obj, dict):\n        raise ValueError("Expected a JSON object")\n    return obj\n\ndef strip_fences(text):\n    text = text.strip()\n    if text.startswith("```") and text.endswith("```"):\n        return re.sub(r"^```(?:json)?\\s*", "", text, count=1, flags=re.IGNORECASE)[:-3].strip()\n    return text\n\ndef facts(value, path=""):\n    """Multiset of (field path, normalized value); array order is ignored."""\n    result = Counter()\n    if isinstance(value, dict):\n        for key, child in value.items():\n            result.update(facts(child, f"{path}.{key}" if path else key))\n    elif isinstance(value, list):\n        for child in value:\n            result.update(facts(child, path))\n    elif value is not None:\n        normalized = " ".join(str(value).casefold().split())\n        if normalized not in MISSING_VALUES:\n            result[(path, normalized)] += 1\n    return result\n\ndef facts_by_path(value, path=""):\n    """Mapping field path -> list of normalized non-missing values."""\n    result = {}\n    for (p, v), cnt in facts(value, path).items():\n        result.setdefault(p, []).extend([v] * cnt)\n    return result\n\ndef key_paths(value, prefix=""):\n    result = set()\n    if isinstance(value, dict):\n        for key, child in value.items():\n            path = f"{prefix}.{key}" if prefix else key\n            result.add(path)\n            result.update(key_paths(child, path))\n    elif isinstance(value, list):\n        for child in value:\n            result.update(key_paths(child, prefix))\n    return result\n\ndef _token_f1(a_str, b_str):\n    ta = Counter(re.findall(r"[a-z0-9]+", a_str.casefold()))\n    tb = Counter(re.findall(r"[a-z0-9]+", b_str.casefold()))\n    na, nb = sum(ta.values()), sum(tb.values())\n    if not na or not nb:\n        return 0.0\n    ov = sum((ta & tb).values())\n    return (2.0 * ov) / (na + nb)\n\ndef soft_fact_scores(expected_obj, actual_obj):\n    if actual_obj is None:\n        return 0.0, 0.0, 0.0\n    exp_map = facts_by_path(expected_obj)\n    act_map = facts_by_path(actual_obj)\n    n_exp = sum(len(v) for v in exp_map.values())\n    n_act = sum(len(v) for v in act_map.values())\n    if not n_exp or not n_act:\n        return 0.0, 0.0, 0.0\n    total_sim = 0.0\n    for path, exp_vals in exp_map.items():\n        act_vals = act_map.get(path, [])\n        if not act_vals:\n            continue\n        pairs = []\n        for i, ev in enumerate(exp_vals):\n            for j, av in enumerate(act_vals):\n                s = 1.0 if ev == av else _token_f1(ev, av)\n                if s > 0:\n                    pairs.append((s, i, j))\n        pairs.sort(reverse=True)\n        used_e, used_a = set(), set()\n        for s, i, j in pairs:\n            if i not in used_e and j not in used_a:\n                used_e.add(i)\n                used_a.add(j)\n                total_sim += s\n    prec = total_sim / n_act\n    rec = total_sim / n_exp\n    f1 = (2 * prec * rec / (prec + rec)) if (prec + rec) else 0.0\n    return prec, rec, f1\n\ndef count_duplicate_array_items(text):\n    try:\n        obj = load_object(strip_fences(text))\n    except ValueError:\n        return None\n    dups = 0\n    def walk(node):\n        nonlocal dups\n        if isinstance(node, list):\n            seen = set()\n            for item in node:\n                key = json.dumps(item, ensure_ascii=False, sort_keys=True)\n                if key in seen:\n                    dups += 1\n                seen.add(key)\n            for item in node:\n                walk(item)\n        elif isinstance(node, dict):\n            for v in node.values():\n                walk(v)\n    walk(obj)\n    return dups\n\ndef max_word_5gram_repeat(text):\n    words = re.findall(r"\\S+", text.lower())\n    if len(words) < 5:\n        return 0\n    counts = Counter(tuple(words[i:i+5]) for i in range(len(words) - 4))\n    return max(counts.values()) if counts else 0\n\ndef evaluate_output(text, reference):\n    expected = load_object(reference)\n    raw_valid = True\n    try:\n        load_object(text)\n    except ValueError:\n        raw_valid = False\n    try:\n        actual = load_object(strip_fences(text))\n        error = None\n    except ValueError as exc:\n        actual, error = None, str(exc)\n    expected_facts = facts(expected)\n    actual_facts = facts(actual)\n    matches = sum((expected_facts & actual_facts).values())\n    n_actual, n_expected = sum(actual_facts.values()), sum(expected_facts.values())\n    precision = matches / n_actual if n_actual else 0.0\n    recall = matches / n_expected if n_expected else 0.0\n    soft_p, soft_r, soft_f1 = soft_fact_scores(expected, actual)\n    return {\n        "empty": not text.strip(),\n        "raw_json_object_valid": raw_valid,\n        "json_object_valid_after_fence_removal": actual is not None,\n        "parse_error": error,\n        "allowed_schema_valid": schema_valid(actual),\n        "raw_allowed_schema_valid": raw_valid and schema_valid(actual),\n        "exact_top_level_keys": actual is not None and set(actual.keys()) == set(TOP_LEVEL_KEYS),\n        "exact_key_match": actual is not None and key_paths(actual) == key_paths(expected),\n        "nonmissing_generated_values": n_actual,\n        "reference_values": n_expected,\n        "matched_values": matches,\n        "placeholder_only": actual is not None and n_actual == 0,\n        "value_precision": precision,\n        "value_recall": recall,\n        "value_f1": 2 * precision * recall / (precision + recall) if precision + recall else 0.0,\n        "soft_value_precision": soft_p,\n        "soft_value_recall": soft_r,\n        "soft_value_f1": soft_f1,\n        "duplicate_array_items": count_duplicate_array_items(text),\n        "max_5gram_repeat": max_word_5gram_repeat(text),\n    }\n\ndef score_run(cases, outputs, diagnostics):\n    records = []\n    for case in cases:\n        key = case["case_id"]\n        text = outputs[key]\n        records.append({\n            "case_id": key,\n            **evaluate_output(text, case["reference"]),\n            "reached_budget": bool(diagnostics[key].get("reached_budget")),\n            "generated_tokens": int(diagnostics[key]["generated_tokens"]),\n            "generated": text,\n            "reference": case["reference"],\n        })\n    frame = pd.DataFrame(records)\n    summary = {"selected_cases": len(cases), "evaluated_cases": len(records)}\n    for name in (\n        "empty", "raw_json_object_valid", "json_object_valid_after_fence_removal",\n        "exact_top_level_keys", "allowed_schema_valid", "raw_allowed_schema_valid", "exact_key_match", "placeholder_only", "reached_budget",\n    ):\n        summary[name + "_cases"] = int(frame[name].sum())\n    for name in (\n        "value_precision", "value_recall", "value_f1",\n        "soft_value_precision", "soft_value_recall", "soft_value_f1",\n    ):\n        summary["mean_" + name] = float(frame[name].mean())\n    for key, col in (\n        ("matched_values", "matched_values"),\n        ("reference_values", "reference_values"),\n        ("generated_values", "nonmissing_generated_values"),\n    ):\n        summary[key] = int(frame[col].sum())\n    summary["mean_generated_tokens"] = float(frame["generated_tokens"].mean())\n    summary["max_5gram_repeat_ge_3_cases"] = int((frame["max_5gram_repeat"] >= 3).sum())\n    return frame, summary\n\n# Metric self-checks\nref = \'{"age":"29","symptoms":[{"name":"chest pain"}]}\'\nassert evaluate_output(ref, ref)["value_f1"] == 1.0\nassert evaluate_output("```json\\n" + ref + "\\n```", ref)["raw_json_object_valid"] is False\nassert evaluate_output("```json\\n" + ref + "\\n```", ref)["json_object_valid_after_fence_removal"] is True\nassert evaluate_output(\'{"age":"None"}\', ref)["placeholder_only"] is True\nassert 0.0 < evaluate_output(\'{"age":"29","symptoms":[{"name":"severe chest pain"}]}\', ref)["soft_value_f1"] < 1.0\nprint("Metric self-checks passed.")'}, {'cell_type': 'markdown', 'id': '01_baseline_eval_7', 'metadata': {}, 'source': '## Generate baseline outputs\nSave predictions and diagnostics after each case.'}, {'cell_type': 'code', 'execution_count': 4, 'id': '01_baseline_eval_8', 'metadata': {'execution': {'iopub.execute_input': '2026-11-23T08:54:39.812532Z', 'iopub.status.busy': '2026-11-23T08:54:39.812041Z', 'iopub.status.idle': '2026-11-23T08:55:05.317326Z', 'shell.execute_reply': '2026-11-23T08:55:05.316467Z'}, 'trusted': False}, 'outputs': [{'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '1ab4896aed3b4a81a7757a4f8ebb04b9', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer_config.json: 0.00B [00:00, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'name': 'stderr', 'output_type': 'stream', 'text': "/usr/local/lib/python3.13/dist-packages/huggingface_hub/utils/_auth.py:104: UserWarning: \nError while fetching `HF_TOKEN` secret value from your vault: 'Requesting secret HF_TOKEN timed out. Secrets can only be fetched when running from the Colab UI.'.\nYou are not authenticated with the Hugging Face Hub in this notebook.\nIf the error persists, please let us know by opening an issue on GitHub (https://github.com/huggingface/huggingface_hub/issues/new).\n  warnings.warn(\n"}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '2bdda47cef2149b4a80afb8b38e2f636', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer.model:   0%|          | 0.00/4.69M [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '1fb25975bbf04f71b91cbe318ff5b40b', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'tokenizer.json:   0%|          | 0.00/33.4M [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'ace625348eab471cacea8ebd473d01b9', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'added_tokens.json:   0%|          | 0.00/35.0 [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '2599fce441654eb6beb842168e41f66d', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'special_tokens_map.json:   0%|          | 0.00/662 [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '48186bb514d04d99a1e01c238b820491', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'chat_template.jinja: 0.00B [00:00, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'a9cf6693ae614175b65d4e82929d84de', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'config.json: 0.00B [00:00, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': '99c391eec3734f298aefec7b0fc3b65b', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'model.safetensors:   0%|          | 0.00/536M [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'data': {'application/vnd.jupyter.widget-view+json': {'model_id': 'e6795afd2d984632b28d9075d1fd2ce1', 'version_major': 2, 'version_minor': 0}, 'text/plain': 'generation_config.json:   0%|          | 0.00/173 [00:00<?, ?B/s]'}, 'metadata': {}, 'output_type': 'display_data'}, {'name': 'stdout', 'output_type': 'stream', 'text': 'Baseline predictions saved for 100 cases; cached cases are reused under the verified contract.\n'}], 'source': 'token = read_token()\ntokenizer = AutoTokenizer.from_pretrained(MODEL_ID, revision=MODEL_REVISION, token=token)\npad_id = tokenizer.pad_token_id or tokenizer.eos_token_id\nrandom.seed(SEED)\ntorch.manual_seed(SEED)\nmodel = AutoModelForCausalLM.from_pretrained(MODEL_ID, revision=MODEL_REVISION, token=token, dtype=dtype).to(device).eval()\neos = model.generation_config.eos_token_id\neos_ids = eos if isinstance(eos, list) else [eos]\n\nfor cond in DECODING_CONDITIONS:\n    cond_dir = OUTPUT_ROOT / cond["tag"]\n    cond_dir.mkdir(parents=True, exist_ok=True)\n    gen_path = cond_dir / "generations.json"\n    diag_path = cond_dir / "generation_diagnostics.json"\n    generations = json.loads(gen_path.read_text(encoding="utf-8")) if gen_path.exists() else {}\n    diagnostics = json.loads(diag_path.read_text(encoding="utf-8")) if diag_path.exists() else {}\n    started = time.monotonic()\n    for case in cases:\n        key = case["case_id"]\n        if generations.get(key, "").strip() and key in diagnostics:\n            continue\n        inputs = tokenizer(case["prompt_text"], return_tensors="pt", add_special_tokens=False).to(device)\n        n_prompt = inputs.input_ids.shape[1]\n        assert n_prompt + MAX_NEW_TOKENS <= model.config.max_position_embeddings\n        with torch.inference_mode():\n            logits = model(**inputs, logits_to_keep=1).logits[:, -1, :]\n            finite = bool(torch.isfinite(logits).all().item())\n            del logits\n            if not finite:\n                ids = []\n            else:\n                gen_kwargs = {"max_new_tokens": MAX_NEW_TOKENS, "do_sample": False, "pad_token_id": pad_id}\n                if cond["generated_only"] and cond["repetition_penalty"] != 1.0:\n                    gen_kwargs["logits_processor"] = LogitsProcessorList([\n                        GeneratedOnlyRepetitionPenalty(cond["repetition_penalty"], n_prompt)\n                    ])\n                generated = model.generate(**inputs, **gen_kwargs)\n                ids = generated[0, n_prompt:].tolist()\n        text = tokenizer.decode(ids, skip_special_tokens=True)\n        diagnostics[key] = {\n            "prompt_tokens": n_prompt,\n            "generated_tokens": len(ids),\n            "finite_first_token_logits": finite,\n            "empty_output": not text.strip(),\n            "reached_budget": len(ids) >= MAX_NEW_TOKENS,\n            "ended_with_eos": bool(ids) and ids[-1] in eos_ids,\n        }\n        diag_path.write_text(json.dumps(diagnostics, ensure_ascii=False, indent=2), encoding="utf-8")\n        if not finite or not text.strip():\n            raise RuntimeError(f"base/{cond[\'tag\']}/{key}: failed generation")\n        generations[key] = text\n        gen_path.write_text(json.dumps(generations, ensure_ascii=False, indent=2), encoding="utf-8")\n        print(f"[base | {cond[\'tag\']}] {len(generations)}/{len(cases)} {key}: {len(ids)} toks ({time.monotonic()-started:.1f}s)", flush=True)\n\nprint(f"Baseline predictions saved for {len(cases)} cases; cached cases are reused under the verified contract.", flush=True)\ndel model\nif device == "cuda":\n    torch.cuda.empty_cache()'}, {'cell_type': 'markdown', 'id': '01_baseline_eval_9', 'metadata': {}, 'source': '## Save baseline scores and archive'}, {'cell_type': 'code', 'execution_count': 5, 'id': '01_baseline_eval_10', 'metadata': {'execution': {'iopub.execute_input': '2026-11-23T08:55:05.325692Z', 'iopub.status.busy': '2026-11-23T08:55:05.324950Z', 'iopub.status.idle': '2026-11-23T08:55:05.614126Z', 'shell.execute_reply': '2026-11-23T08:55:05.613233Z'}, 'trusted': False}, 'outputs': [{'data': {'text/html': '\n  <div id="df-1ab9d43b-6d6a-4875-8f95-8c8b33f304ab" class="colab-df-container">\n    <div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border="1" class="dataframe">\n  <thead>\n    <tr style="text-align: right;">\n      <th></th>\n      <th>model</th>\n      <th>decoding</th>\n      <th>selected_cases</th>\n      <th>ev